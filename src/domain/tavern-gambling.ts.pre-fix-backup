export function createTavernMahjongDeck(): TavernMahjongTile[] {
  const tiles: TavernMahjongTile[] = [];
  for (const suit of Object.keys(suitLabels) as TavernMahjongSuit[]) {
    for (let rank = 1; rank <= 9; rank += 1) {
      for (let copy = 1; copy <= 4; copy += 1) {
        tiles.push({ id: `${suit}-${rank}-${copy}`, kind: "suited", suit, rank, copy });
      }
    }
  }
  for (const honor of Object.keys(honorLabels) as TavernMahjongHonor[]) {
    for (let copy = 1; copy <= 4; copy += 1) {
      tiles.push({ id: `${honor}-${copy}`, kind: "honor", honor, copy });
    }
  }
  for (const flower of Object.keys(flowerLabels) as TavernMahjongFlower[]) {
    tiles.push({ id: `flower-${flower}`, kind: "flower", flower });
  }
  return tiles;
}

export function shuffleTavernMahjongDeck(deck: TavernMahjongTile[], seed: number): TavernMahjongTile[] {
  const result = [...deck];
  let cursor = seed <= 0 ? 1 : seed;
  for (let index = result.length - 1; index > 0; index -= 1) {
    cursor = (cursor * 1664525 + 1013904223) >>> 0;
    const swapIndex = cursor % (index + 1);
    const current = result[index];
    const swap = result[swapIndex];
    if (current != null && swap != null) {
      result[index] = swap;
      result[swapIndex] = current;
    }
  }
  return result;
}

export function getTavernMahjongTileLabel(tile: TavernMahjongTile): string {
  if (tile.kind === "suited") {
    return `${tile.rank}${suitLabels[tile.suit]}`;
  }
  if (tile.kind === "honor") {
    return honorLabels[tile.honor];
  }
  return flowerLabels[tile.flower];
}

export function getTavernMahjongTileKey(tile: TavernMahjongTile): string {
  if (tile.kind === "suited") {
    return `${tile.suit}-${tile.rank}`;
  }
  if (tile.kind === "honor") {
    return tile.honor;
  }
  return tile.flower;
}

