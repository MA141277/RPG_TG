    ...session,
    pendingDrawTile: null,
    pendingDiscardsRemaining: 0,
    pendingMelds: [],
    meldWindow: null,
    meldCountdownTicks: 0,
    npcThinkingSeat: null,
    npcThinkTicksRemaining: 0,
    roundLog: [...session.roundLog, log],
