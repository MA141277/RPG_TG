  if (pendingMelds.length > 0) {
    return {
      ...withDrawn,
      phase: "meld-window",
      pendingMelds,
      meldWindow: {
        source: "draw",
        stage: "kong",
        discardTileId: null,
        resumeNpcAfterSeat: null,
      },
      meldCountdownTicks: getGambleMeldResponseSeconds(session),
    };
  }
  if (isLongGamble(withDrawn)) {
    return enterPostDrawDiscard(withDrawn, "闀跨墝鎽?3 寮犲悗锛岃浠庢殫鐗屾垨鑷繁鐨勬槑鐗屾Ы寮?3 寮犮€?");
  }
