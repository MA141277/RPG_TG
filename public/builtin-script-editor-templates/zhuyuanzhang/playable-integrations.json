            "text": "这桩事不见刀光，却最考验耐性。",
            "choices": [
              {
                "id": "trace",
                "label": "依字描摹"
              },
              {
                "id": "balance",
                "label": "稳腕正锋"
              },
              {
                "id": "review",
                "label": "核对残页"
              }
            ],
            "expectedChoiceId": "balance"
          }
        ],
        "requiredScore": 1
      }
    },
