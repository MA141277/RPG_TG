      }),
      clearActionId: COMPOUND_CLEAR_ACTION_ID,
      clearLabel: "清空药盘",
      finishActionId: "compound-finish",
      finishLabel: "封炉成方"
    };
  }
  return {
    type: "result",
    title: "配药结算",
    grade: overlay.grade,
