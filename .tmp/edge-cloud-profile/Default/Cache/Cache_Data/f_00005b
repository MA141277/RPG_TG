function sampleWithoutReplacement(items, count) {
  const pool = [...items];
  const result = [];
  while (pool.length > 0 && result.length < count) {
    const index = randomInt(0, pool.length - 1);
    const [pickedItem] = pool.splice(index, 1);
    if (pickedItem != null) {
      result.push(pickedItem);
    }
  }
  return result;
}
