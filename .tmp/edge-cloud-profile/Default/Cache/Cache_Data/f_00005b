    `关系 ${outcome.relationshipChange >= 0 ? "+" : ""}${outcome.relationshipChange}`,
    `时间 +${outcome.timeCost}`
  ];
  if (outcome.inventoryChange.length > 0) {
    summaryLines.push(
      ...outcome.inventoryChange.map((change) => {
        const goodsName = goodsPool.find((goodsDefinition) => goodsDefinition.id === change.goodsId)?.name ?? change.goodsId;
