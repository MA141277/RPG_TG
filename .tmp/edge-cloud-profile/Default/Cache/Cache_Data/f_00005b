function getBuyPriceModifier(favorability) {
  return Math.max(0.88, Math.min(1.12, Number((1 - favorability * 5e-3).toFixed(3))));
}
function getSellPriceModifier(favorability) {
  return Math.max(0.88, Math.min(1.08, Number((1 + favorability * 4e-3).toFixed(3))));
}
function adjustBuyPrice(basePrice, favorability) {
  return Math.max(1, Math.round(basePrice * getBuyPriceModifier(favorability)));
}
function adjustSellPrice(baseSellPrice, adjustedBuyPrice, favorability) {
  return Math.max(
    1,
    Math.min(adjustedBuyPrice - 1, Math.round(baseSellPrice * getSellPriceModifier(favorability)))
  );
}
