{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/application/character/**/*.ts",
    "src/application/activity/**/*.ts",
    "src/application/building/**/*.ts",
    "src/application/city/**/*.ts",
    "src/application/city-entries/**/*.ts",
    "src/application/city-menu/**/*.ts",
    "src/application/city-npcs/**/*.ts",
    "src/application/content/**/*.ts",
    "src/application/events/**/*.ts",
    "src/application/grain-shop/**/*.ts",
    "src/application/house/**/*.ts",
    "src/application/house-modules/**/*.ts",
    "src/application/inventory/**/*.ts",
    "src/application/leader-residence/**/*.ts",
    "src/application/map/**/*.ts",
    "src/application/medicine-house/**/*.ts",
    "src/application/minigames/**/*.ts",
    "src/application/navigation/**/*.ts",
    "src/application/player/**/*.ts",
    "src/application/playables/**/*.ts",
    "src/application/review/**/*.ts",
    "src/application/runtime/**/*.ts",
    "src/application/scenario/**/*.ts",
    "src/application/scene/**/*.ts",
    "src/application/script-editor/**/*.ts",
    "src/application/startup/**/*.ts",
    "src/application/state/**/*.ts",
    "src/application/story/**/*.ts",
    "src/application/story-battle/**/*.ts",
    "src/application/tea-house/**/*.ts",
    "src/application/time/**/*.ts",
    "src/application/ui/**/*.ts",
    "src/domain/**/*.ts",
    "src/shared/**/*.ts",
    "src/types/**/*.d.ts",
    "src/vite-env.d.ts",
    "src/content/base-game-content-pack.ts",
    "src/content/prototype-world.ts",
    "src/content/scenarios/**/*.ts",
    "src/content/scenario-packs/scenario-pack-catalog.ts",
    "src/content/houses/**/*.ts",
    "src/content/markets/**/*.ts",
    "src/content/ui/**/*.ts"
  ],
  "exclude": [
    "src/main.ts",
    "src/terrain-webgl/**/*.ts",
    "src/ui/**/*.ts",
    "src/ui/views/building/**/*.ts",
    "src/content/portrait-assets.ts",
    "src/content/yuanmo-campaign-map.ts"
  ]
}
